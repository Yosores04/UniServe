{
  "name": "uniserve",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "android:debug": "tsc -b && node scripts/android-assets.mjs debug && cap sync android && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-gradle.ps1 assembleDebug",
    "android:release": "tsc -b && node scripts/android-assets.mjs release && cap sync android && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-gradle.ps1 assembleRelease",
    "test": "vitest run --config vitest.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "server:dev": "tsx watch server/src/server.ts",
    "dev:full": "concurrently \"npm run server:dev\" \"npm run dev\"",
    "demo:setup": "node scripts/demo-setup.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:urls": "node scripts/demo-urls.mjs",
    "demo:check": "node --experimental-websocket scripts/browser-smoke.mjs",
    "demo:firewall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/allow-demo-phones.ps1",
    "server:build": "tsc -p server/tsconfig.json",
    "cloud:schema": "node scripts/cloud-schema.mjs",
    "cloud:build": "npm run cloud:schema && prisma generate --schema prisma/cloud/schema.prisma && npm run build && npm run server:build",
    "cloud:migrate": "prisma migrate deploy --schema prisma/cloud/schema.prisma",
    "cloud:start": "npm run cloud:migrate && node scripts/cloud-admin.mjs && node server/dist/src/server.js",
    "server:test": "vitest run --config vitest.config.ts server/src",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "7.6.10",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^5.24.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
